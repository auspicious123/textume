# Optional GitHub OAuth — local resumes work with these unset.
# Create an OAuth App: https://github.com/settings/developers
# Enable Device Flow on the app.
#
# Client ID is public (safe in the browser bundle).
# Never put the client secret in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# BusyTeX asset source (env only — no Settings UI).
#   local = public/core/busytex after `npm run latex:assets` (default for clones)
#   r2    = CDN URL below (production / when local blobs are not present)
#
# Local clone: keep SOURCE=local. No BASE_URL, CORS, or R2_* needed.
# Production: SOURCE=r2 + BASE_URL (see docs/BUSYTEX_CDN.md).

NEXT_PUBLIC_BUSYTEX_SOURCE=local
NEXT_PUBLIC_BUSYTEX_BASE_URL=

# --- R2 upload only (npm run busytex:upload-r2) ---
# Only for people uploading assets to Cloudflare R2.
# Not used at runtime for SOURCE=local. Do not put on Vercel unless CI uploads.
#
# 1. npx wrangler login  (files ≤ 300 MiB)
# 2. Cloudflare → R2 → Manage R2 API Tokens → Create API token
#    (Object Read & Write) for texlive-extra.data (> 300 MiB)
# 3. Account ID: Cloudflare → R2 → Overview
# 4. npm run latex:assets
# 5. npm run busytex:upload-r2
#
# Details: docs/BUSYTEX_CDN.md

R2_BUCKET=textume-busytex
R2_PREFIX=busytex
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
